rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Health / connection test
    match /test/{docId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'jairosenna14@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOrgAdmin(orgId) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/organizations/$(orgId)/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Admins reference collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
    }

    // Organization scope
    match /organizations/{orgId} {
      allow read: if isSignedIn() && isValidId(orgId);
      allow write: if isSuperAdmin();

      // Users within organization
      match /users/{userId} {
        allow read: if isSignedIn() && isValidId(userId);
        allow create: if isSignedIn() && isValidId(userId) && (
          request.auth.uid == userId || isOrgAdmin(orgId)
        );
        allow update: if isSignedIn() && isValidId(userId) && (
          isOrgAdmin(orgId) || 
          (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'active']))
        );
        allow delete: if isOrgAdmin(orgId);
      }

      // Cases within organization
      match /cases/{caseId} {
        allow read: if isSignedIn() && isValidId(caseId);
        allow create: if isSignedIn() && isValidId(caseId) && isOrgAdmin(orgId);
        allow update: if isSignedIn() && isValidId(caseId) && (
          isOrgAdmin(orgId) || (
            resource.data.status != 'concluido' &&
            request.resource.data.status != 'concluido'
          )
        );
        allow delete: if isOrgAdmin(orgId);

        // Subcollections of Case
        match /involved/{involvedId} {
          allow read: if isSignedIn() && isValidId(involvedId);
          allow create, update: if isSignedIn() && isValidId(involvedId) && (
            isOrgAdmin(orgId) || 
            get(/databases/$(database)/documents/organizations/$(orgId)/cases/$(caseId)).data.status != 'concluido'
          );
          allow delete: if isOrgAdmin(orgId);
        }

        match /connections/{connectionId} {
          allow read: if isSignedIn() && isValidId(connectionId);
          allow create, update: if isSignedIn() && isValidId(connectionId) && (
            isOrgAdmin(orgId) || 
            get(/databases/$(database)/documents/organizations/$(orgId)/cases/$(caseId)).data.status != 'concluido'
          );
          allow delete: if isOrgAdmin(orgId);
        }

        match /diligences/{diligenceId} {
          allow read: if isSignedIn() && isValidId(diligenceId);
          allow create, update: if isSignedIn() && isValidId(diligenceId) && (
            isOrgAdmin(orgId) || 
            get(/databases/$(database)/documents/organizations/$(orgId)/cases/$(caseId)).data.status != 'concluido'
          );
          allow delete: if isOrgAdmin(orgId);
        }

        match /files/{fileId} {
          allow read: if isSignedIn() && isValidId(fileId);
          allow create, update: if isSignedIn() && isValidId(fileId) && (
            isOrgAdmin(orgId) || 
            get(/databases/$(database)/documents/organizations/$(orgId)/cases/$(caseId)).data.status != 'concluido'
          );
          allow delete: if isOrgAdmin(orgId);
        }

        match /payments/{paymentId} {
          allow read: if isSignedIn() && isValidId(paymentId) && isOrgAdmin(orgId);
          allow create, update, delete: if isSignedIn() && isValidId(paymentId) && isOrgAdmin(orgId);
        }

        // Immutable Audit Trail
        match /activityLog/{logId} {
          allow read: if isSignedIn() && isValidId(logId);
          allow create: if isSignedIn() && isValidId(logId);
          allow update, delete: if false;
        }
      }
    }
  }
}
