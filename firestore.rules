rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Health / connection test
    match /test/{docId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // All collections and subcollections accessible:
    // Read is allowed to prevent loading drops while auth state is restoring
    // Write requires active authenticated user
    match /{document=**} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}


