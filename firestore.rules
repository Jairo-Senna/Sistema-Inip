rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /test/{docId} {
      allow read, write: if true;
    }
    match /organizations/{orgId} {
      allow read, write: if true;
      
      match /users/{userId} {
        allow read, write: if true;
      }
      
      match /cases/{caseId} {
        allow read, write: if true;
        
        match /{subcollection=**} {
          allow read, write: if true;
        }
      }
    }
    
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
