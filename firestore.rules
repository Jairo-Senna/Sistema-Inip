rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Health / connection test
    match /test/{docId} {
      allow read: if true;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    // All collections and subcollections accessible to authenticated users
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}


